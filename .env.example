# Local server port. Hosting platforms typically provide PORT automatically.
PORT=18089

# SQLite database file path. On Vercel the default is /tmp (ephemeral); set DB_PATH to a persistent volume if available.
# DB_PATH=/tmp/amde-jewellery.db

# Generate a unique value for every production deployment.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Production requires an explicit username and password of at least 12 chars.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# Optional Telegram delivery for customer inquiries.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=
